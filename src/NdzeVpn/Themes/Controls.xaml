<!-- Minimal control set. Flat surfaces, 1px hairlines, one type family, no shadows or gradients.
     All colours come from theme brushes via DynamicResource so a theme swap re-skins live. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="F.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="F.Mono">Cascadia Mono, Consolas</FontFamily>

    <!-- ============================================================ text -->

    <Style x:Key="T.Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource B.Fg}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="T.H2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource B.Fg}" />
    </Style>
    <Style x:Key="T.H3" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource B.Fg}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="T.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource B.FgSecondary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="T.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource B.FgMuted}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- Small section label above a group. -->
    <Style x:Key="T.Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource B.FgMuted}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="T.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Mono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource B.FgSecondary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="T.Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Icons}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- ============================================================ icons -->
    <!-- Stroke icons on a 24x24 grid. Vector, so they look the same on Windows 10 (no Segoe Fluent
         Icons there) and at any DPI. Use with the Icon / Icon.Sm / Icon.Xs Path styles. -->
    <Geometry x:Key="I.Power">M12,3 V11.5 M5.87,6.86 A8,8 0 1 0 18.13,6.86</Geometry>
    <Geometry x:Key="I.Globe">M12,3 A9,9 0 1 1 11.99,3 Z M3.5,9 H20.5 M3.5,15 H20.5 M12,3 C8.5,6.5 8.5,17.5 12,21 M12,3 C15.5,6.5 15.5,17.5 12,21</Geometry>
    <Geometry x:Key="I.Inbox">M4,5 H20 M4,10 H20 M4,15 H11 M17,13 V21 M13.5,17.5 L17,21 L20.5,17.5</Geometry>
    <Geometry x:Key="I.Route">M12,21 V13 M12,13 C12,9 6,9 6,5 M12,13 C12,9 18,9 18,5 M3.5,7.5 L6,5 L8.5,7.5 M15.5,7.5 L18,5 L20.5,7.5</Geometry>
    <Geometry x:Key="I.Sliders">M4,7 H13 M17,7 H20 M4,17 H7 M11,17 H20 M15,4.5 V9.5 M9,14.5 V19.5</Geometry>
    <Geometry x:Key="I.Doc">M6,3 H14 L19,8 V21 H6 Z M14,3 V8 H19 M9,13 H16 M9,17 H14</Geometry>
    <Geometry x:Key="I.Sidebar">M4,4.5 H20 V19.5 H4 Z M9.5,4.5 V19.5</Geometry>
    <Geometry x:Key="I.ChevronLeft">M15,5 L8,12 L15,19</Geometry>
    <Geometry x:Key="I.ChevronRight">M9,5 L16,12 L9,19</Geometry>
    <Geometry x:Key="I.ChevronUp">M5,15 L12,8 L19,15</Geometry>
    <Geometry x:Key="I.ChevronDown">M5,9 L12,16 L19,9</Geometry>
    <Geometry x:Key="I.Close">M6,6 L18,18 M18,6 L6,18</Geometry>
    <Geometry x:Key="I.More">M5,12 L5.01,12 M12,12 L12.01,12 M19,12 L19.01,12</Geometry>
    <Geometry x:Key="I.Download">M12,4 V15 M7,10 L12,15 L17,10 M5,20 H19</Geometry>
    <Geometry x:Key="I.Chat">M4,5 H20 V16 H11 L6.5,20 V16 H4 Z M8.5,10.5 L8.51,10.5 M12,10.5 L12.01,10.5 M15.5,10.5 L15.51,10.5</Geometry>
    <Geometry x:Key="I.External">M14,4 H20 V10 M20,4 L11,13 M18,14 V20 H4 V6 H10</Geometry>
    <!-- window caption glyphs, 10x10 -->
    <Geometry x:Key="I.WinMin">M0,5.5 H10</Geometry>
    <Geometry x:Key="I.WinMax">M0.5,0.5 H9.5 V9.5 H0.5 Z</Geometry>
    <Geometry x:Key="I.WinRestore">M2.5,2.5 H9.5 V9.5 H2.5 Z M0.5,7.5 V0.5 H7.5</Geometry>
    <Geometry x:Key="I.WinClose">M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5</Geometry>

    <!-- 18px; stroke follows the nearest control's Foreground so hover/checked states recolour it. -->
    <Style x:Key="Icon" TargetType="Path">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="LayoutTransform">
            <Setter.Value><ScaleTransform ScaleX="0.75" ScaleY="0.75" /></Setter.Value>
        </Setter>
    </Style>
    <!-- 14px -->
    <Style x:Key="Icon.Sm" TargetType="Path" BasedOn="{StaticResource Icon}">
        <Setter Property="StrokeThickness" Value="2.4" />
        <Setter Property="LayoutTransform">
            <Setter.Value><ScaleTransform ScaleX="0.5834" ScaleY="0.5834" /></Setter.Value>
        </Setter>
    </Style>
    <!-- 11px -->
    <Style x:Key="Icon.Xs" TargetType="Path" BasedOn="{StaticResource Icon}">
        <Setter Property="StrokeThickness" Value="2.8" />
        <Setter Property="LayoutTransform">
            <Setter.Value><ScaleTransform ScaleX="0.4584" ScaleY="0.4584" /></Setter.Value>
        </Setter>
    </Style>
    <!-- Window caption: native 10x10 geometry, 1px stroke. -->
    <Style x:Key="Icon.Caption" TargetType="Path">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Line" TargetType="Rectangle">
        <Setter Property="Height" Value="1" />
        <Setter Property="Fill" Value="{DynamicResource B.Border}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ============================================================ buttons -->

    <Style x:Key="Btn.Base" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Solid block in the foreground colour: the one main action per screen. -->
    <Style x:Key="Btn.Primary" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Foreground" Value="{DynamicResource B.AccentFg}" />
        <Setter Property="Background" Value="{DynamicResource B.Accent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource R.Card}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Hairline-bordered secondary button. -->
    <Style x:Key="Btn.Outline" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Foreground" Value="{DynamicResource B.Fg}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource B.Border}"
                            BorderThickness="1" CornerRadius="{DynamicResource R.Card}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.Hover}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource B.FgMuted}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Btn.Chip" TargetType="Button" BasedOn="{StaticResource Btn.Outline}">
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

    <!-- Text-only action; brightens on hover. -->
    <Style x:Key="Btn.Link" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Foreground" Value="{DynamicResource B.FgSecondary}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter Margin="{TemplateBinding Padding}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource B.Fg}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Btn.Icon" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Foreground" Value="{DynamicResource B.FgSecondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource F.Icons}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource B.Fg}" />
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Btn.Caption" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Foreground" Value="{DynamicResource B.FgMuted}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource B.Fg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Btn.CaptionClose" TargetType="Button" BasedOn="{StaticResource Btn.Caption}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#E81123" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ selection -->

    <!-- Sidebar entry: icon (Tag = Geometry) + label; the label hides when the sidebar is collapsed
         (DataContext.IsSidebarCollapsed) and becomes a tooltip instead. Works for Button and ToggleButton. -->
    <ControlTemplate x:Key="Nav.Template" TargetType="ToggleButton">
        <Border x:Name="bd" Background="Transparent" CornerRadius="7">
            <Grid>
                <Rectangle x:Name="bar" Width="2" Height="14" HorizontalAlignment="Left" Fill="{DynamicResource B.Fg}"
                           RadiusX="1" RadiusY="1" Visibility="Hidden" Margin="-10,0,0,0" />
                <StackPanel Orientation="Horizontal" Margin="13,0,0,0" VerticalAlignment="Center">
                    <Path Style="{StaticResource Icon}" StrokeThickness="1.7"
                          Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                    <ContentPresenter x:Name="text" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource B.Fg}" />
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.Hover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource B.Fg}" />
                <Setter TargetName="bar" Property="Visibility" Value="Visible" />
            </Trigger>
            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                <Setter TargetName="text" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="bar" Property="Margin" Value="-6,0,0,0" />
                <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <ControlTemplate x:Key="Nav.ActionTemplate" TargetType="Button">
        <Border x:Name="bd" Background="Transparent" CornerRadius="7">
            <StackPanel Orientation="Horizontal" Margin="13,0,0,0" VerticalAlignment="Center">
                <Path Style="{StaticResource Icon}" StrokeThickness="1.7"
                      Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                <ContentPresenter x:Name="text" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.Hover}" />
                <Setter Property="Foreground" Value="{DynamicResource B.Fg}" />
            </Trigger>
            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                <Setter TargetName="text" Property="Visibility" Value="Collapsed" />
                <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="Nav.Item" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource B.FgSecondary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ToolTipService.Placement" Value="Right" />
        <Setter Property="Template" Value="{StaticResource Nav.Template}" />
    </Style>
    <Style x:Key="Nav.Action" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource B.FgSecondary}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ToolTipService.Placement" Value="Right" />
        <Setter Property="Template" Value="{StaticResource Nav.ActionTemplate}" />
    </Style>

    <!-- Segmented control: Seg.Track border holding Seg.Item buttons. -->
    <Style x:Key="Seg.Track" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource B.Elevated}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="Seg.Item" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource B.FgSecondary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource B.Fg}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.Window}" />
                            <Setter Property="Foreground" Value="{DynamicResource B.Fg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filter tab: muted text; the active one is full strength. -->
    <Style x:Key="Chip.Toggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource B.FgMuted}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,0,20,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <ContentPresenter />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource B.FgSecondary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource B.Fg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Option tile (routing mode, theme, tunnel mode): hairline, strong line when chosen. -->
    <Style x:Key="Card.Option" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource B.Fg}" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Background="Transparent" BorderBrush="{DynamicResource B.Border}" BorderThickness="1"
                            CornerRadius="{DynamicResource R.Card}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource B.Fg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ switch -->

    <Style x:Key="Toggle.Switch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource B.Fg}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center" Margin="0,0,20,0" />
                        <Border x:Name="track" Grid.Column="1" Width="34" Height="20" CornerRadius="10"
                                Background="{DynamicResource B.Pressed}" VerticalAlignment="Center">
                            <Ellipse x:Name="knob" Width="14" Height="14" Fill="{DynamicResource B.FgSecondary}"
                                     HorizontalAlignment="Left" Margin="3,0">
                                <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
                            </Ellipse>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{DynamicResource B.Accent}" />
                            <Setter TargetName="knob" Property="Fill" Value="{DynamicResource B.AccentFg}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="knob"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="14" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="knob"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ inputs -->

    <Style x:Key="Input.Text" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource B.Fg}" />
        <Setter Property="Background" Value="{DynamicResource B.Input}" />
        <Setter Property="CaretBrush" Value="{DynamicResource B.Fg}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource B.FgMuted}" />
        <Setter Property="BorderBrush" Value="{DynamicResource B.Border}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="{DynamicResource R.Card}">
                        <Grid>
                            <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" Foreground="{DynamicResource B.FgMuted}"
                                       Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       IsHitTestVisible="False" Visibility="Collapsed" Padding="2,0,0,0" TextTrimming="CharacterEllipsis" />
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="ph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource B.FgMuted}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource B.FgSecondary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Input.Mono" TargetType="TextBox" BasedOn="{StaticResource Input.Text}">
        <Setter Property="FontFamily" Value="{StaticResource F.Mono}" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>
    <!-- Borderless inline edit (subscription name). -->
    <Style x:Key="Input.Inline" TargetType="TextBox" BasedOn="{StaticResource Input.Text}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="0,2" />
    </Style>

    <Style x:Key="Combo.ItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource B.Fg}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="5">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Combo" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource B.Fg}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="MinWidth" Value="150" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Combo.ItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="bd" Background="{DynamicResource B.Input}" CornerRadius="{DynamicResource R.Card}"
                                            BorderThickness="1" BorderBrush="{DynamicResource B.Border}">
                                        <Path Style="{StaticResource Icon.Xs}" Data="{StaticResource I.ChevronDown}"
                                              HorizontalAlignment="Right" Margin="0,0,10,0" Stroke="{DynamicResource B.FgMuted}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource B.FgMuted}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter IsHitTestVisible="False" Margin="11,0,30,0" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          TextElement.Foreground="{DynamicResource B.Fg}" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade" VerticalOffset="4">
                            <Border Background="{DynamicResource B.Elevated}" CornerRadius="{DynamicResource R.Card}" Padding="4"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="320" BorderBrush="{DynamicResource B.Border}" BorderThickness="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Progress.Thin" TargetType="ProgressBar">
        <Setter Property="Height" Value="2" />
        <Setter Property="Foreground" Value="{DynamicResource B.Fg}" />
        <Setter Property="Background" Value="{DynamicResource B.Border}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="1" Background="{TemplateBinding Background}" />
                        <Border x:Name="PART_Indicator" CornerRadius="1" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ scrollbars -->

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border x:Name="th" Background="{DynamicResource B.FgMuted}" Opacity="0.35" Margin="2" CornerRadius="2" />
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="th" Property="Opacity" Value="0.7" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="8" />
                <Setter Property="MinHeight" Value="8" />
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource B.FgMuted}" Opacity="0.35" Margin="2" CornerRadius="2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================ lists / popups -->

    <Style x:Key="List.Row" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource B.Fg}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.Elevated}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="List.Plain" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource List.Row}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource B.Fg}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource B.Elevated}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1"
                            CornerRadius="6" Padding="8,5">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{DynamicResource B.Fg}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource B.Elevated}" CornerRadius="8" Padding="4" MinWidth="180"
                            BorderBrush="{DynamicResource B.Border}" BorderThickness="1">
                        <StackPanel IsItemsHost="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource B.Fg}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="bd" Background="Transparent" Padding="10,7" CornerRadius="5">
                        <ContentPresenter ContentSource="Header" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.Pressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ layout helpers -->

    <!-- Settings row: label/hint left, control right, hairline underneath. -->
    <Style x:Key="Row" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource B.Border}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="0,13" />
    </Style>

    <Style x:Key="Row.Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource B.Fg}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Page heading block spacing. -->
    <Style x:Key="Group" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,0,0,40" />
    </Style>

    <!-- Bottom action bar on editable pages. -->
    <Style x:Key="ApplyBar" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource B.Border}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="48,12" />
        <Setter Property="Background" Value="{DynamicResource B.Window}" />
    </Style>
</ResourceDictionary>
