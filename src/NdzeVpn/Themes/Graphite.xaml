<!-- Graphite: near-black, monochrome, a single soft green for "connected". -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="B.Window" Color="#0E0E0F" />
    <SolidColorBrush x:Key="B.Panel" Color="#141415" />
    <SolidColorBrush x:Key="B.Card" Color="#18181A" />
    <SolidColorBrush x:Key="B.Elevated" Color="#1D1D20" />
    <SolidColorBrush x:Key="B.Hover" Color="#1A1A1C" />
    <SolidColorBrush x:Key="B.Pressed" Color="#26262A" />
    <SolidColorBrush x:Key="B.Border" Color="#242427" />
    <SolidColorBrush x:Key="B.Input" Color="#131314" />

    <SolidColorBrush x:Key="B.Fg" Color="#EDEDEF" />
    <SolidColorBrush x:Key="B.FgSecondary" Color="#9A9AA0" />
    <SolidColorBrush x:Key="B.FgMuted" Color="#5C5C62" />

    <SolidColorBrush x:Key="B.Accent" Color="#EDEDEF" />
    <SolidColorBrush x:Key="B.AccentHover" Color="#FFFFFF" />
    <SolidColorBrush x:Key="B.AccentFg" Color="#0E0E0F" />

    <SolidColorBrush x:Key="B.Success" Color="#6EE7A8" />
    <SolidColorBrush x:Key="B.SuccessSoft" Color="#6EE7A8" Opacity="0.10" />
    <SolidColorBrush x:Key="B.Danger" Color="#F87171" />
    <SolidColorBrush x:Key="B.Warning" Color="#FBBF24" />
    <SolidColorBrush x:Key="B.Info" Color="#93C5FD" />

    <FontFamily x:Key="F.Main">Segoe UI Variable Text, Segoe UI</FontFamily>
    <CornerRadius x:Key="R.Panel">12</CornerRadius>
    <CornerRadius x:Key="R.Card">8</CornerRadius>
    <CornerRadius x:Key="R.Pill">500</CornerRadius>
</ResourceDictionary>
