<!-- Paper: warm off-white, ink-black type, green only for "connected". -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="B.Window" Color="#F7F7F5" />
    <SolidColorBrush x:Key="B.Panel" Color="#FFFFFF" />
    <SolidColorBrush x:Key="B.Card" Color="#FFFFFF" />
    <SolidColorBrush x:Key="B.Elevated" Color="#EFEFEC" />
    <SolidColorBrush x:Key="B.Hover" Color="#F0F0ED" />
    <SolidColorBrush x:Key="B.Pressed" Color="#E6E6E2" />
    <SolidColorBrush x:Key="B.Border" Color="#E4E4E0" />
    <SolidColorBrush x:Key="B.Input" Color="#FFFFFF" />

    <SolidColorBrush x:Key="B.Fg" Color="#141414" />
    <SolidColorBrush x:Key="B.FgSecondary" Color="#6B6B6B" />
    <SolidColorBrush x:Key="B.FgMuted" Color="#A6A6A2" />

    <SolidColorBrush x:Key="B.Accent" Color="#141414" />
    <SolidColorBrush x:Key="B.AccentHover" Color="#000000" />
    <SolidColorBrush x:Key="B.AccentFg" Color="#FFFFFF" />

    <SolidColorBrush x:Key="B.Success" Color="#16A34A" />
    <SolidColorBrush x:Key="B.SuccessSoft" Color="#16A34A" Opacity="0.08" />
    <SolidColorBrush x:Key="B.Danger" Color="#DC2626" />
    <SolidColorBrush x:Key="B.Warning" Color="#D97706" />
    <SolidColorBrush x:Key="B.Info" Color="#2563EB" />

    <FontFamily x:Key="F.Main">Segoe UI Variable Text, Segoe UI</FontFamily>
    <CornerRadius x:Key="R.Panel">12</CornerRadius>
    <CornerRadius x:Key="R.Card">8</CornerRadius>
    <CornerRadius x:Key="R.Pill">500</CornerRadius>
</ResourceDictionary>
