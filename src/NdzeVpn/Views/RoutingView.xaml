<UserControl x:Class="NdzeVpn.Views.RoutingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NdzeVpn.ViewModels"
             xmlns:ctl="clr-namespace:NdzeVpn.Controls"
             x:Name="Self">

    <UserControl.Resources>
        <!-- toggle row: title + hint left, switch right -->
        <Style x:Key="SwitchRow" TargetType="CheckBox" BasedOn="{StaticResource Toggle.Switch}">
            <Setter Property="Margin" Value="0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="48,56,48,40" MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Text="Маршруты" Style="{StaticResource T.Title}" />
                <TextBlock Style="{StaticResource T.Body}" FontSize="14" Margin="0,8,0,36" TextWrapping="Wrap"
                           Text="Что идёт через VPN, а что — через обычный интернет. Порядок: твои правила → блокировка → напрямую → VPN → остальное." />

                <!-- ================= mode ================= -->
                <TextBlock Text="Режим" Style="{StaticResource T.Label}" />
                <UniformGrid Columns="2" Margin="0,4,-10,0">
                    <ctl:SelectButton Style="{StaticResource Card.Option}" Margin="0,0,10,10"
                                      IsChecked="{Binding RoutingMode, Converter={StaticResource EnumEq}, ConverterParameter=Smart, Mode=OneWay}"
                                      Command="{Binding SetRoutingModeCommand}" CommandParameter="Smart">
                        <StackPanel>
                            <TextBlock Text="Умный" Style="{StaticResource T.H3}" FontWeight="SemiBold" />
                            <TextBlock Text="Заблокированное — VPN, российское — напрямую" Style="{StaticResource T.Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                    </ctl:SelectButton>
                    <ctl:SelectButton Style="{StaticResource Card.Option}" Margin="0,0,10,10"
                                      IsChecked="{Binding RoutingMode, Converter={StaticResource EnumEq}, ConverterParameter=Global, Mode=OneWay}"
                                      Command="{Binding SetRoutingModeCommand}" CommandParameter="Global">
                        <StackPanel>
                            <TextBlock Text="Весь трафик" Style="{StaticResource T.H3}" FontWeight="SemiBold" />
                            <TextBlock Text="Всё через VPN, кроме локальной сети" Style="{StaticResource T.Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                    </ctl:SelectButton>
                    <ctl:SelectButton Style="{StaticResource Card.Option}" Margin="0,0,10,10"
                                      IsChecked="{Binding RoutingMode, Converter={StaticResource EnumEq}, ConverterParameter=Custom, Mode=OneWay}"
                                      Command="{Binding SetRoutingModeCommand}" CommandParameter="Custom">
                        <StackPanel>
                            <TextBlock Text="Свои правила" Style="{StaticResource T.H3}" FontWeight="SemiBold" />
                            <TextBlock Text="Только список ниже, без пресетов" Style="{StaticResource T.Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                    </ctl:SelectButton>
                    <ctl:SelectButton Style="{StaticResource Card.Option}" Margin="0,0,10,10"
                                      IsChecked="{Binding RoutingMode, Converter={StaticResource EnumEq}, ConverterParameter=Direct, Mode=OneWay}"
                                      Command="{Binding SetRoutingModeCommand}" CommandParameter="Direct">
                        <StackPanel>
                            <TextBlock Text="Напрямую" Style="{StaticResource T.H3}" FontWeight="SemiBold" />
                            <TextBlock Text="VPN на паузе, твои правила работают" Style="{StaticResource T.Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                    </ctl:SelectButton>
                </UniformGrid>

                <!-- ================= direct ================= -->
                <Grid Margin="0,36,0,0">
                    <TextBlock Text="Напрямую" Style="{StaticResource T.Label}" />
                    <Button Style="{StaticResource Btn.Link}" Content="Сбросить пресеты" FontSize="12" HorizontalAlignment="Right"
                            VerticalAlignment="Top" Command="{Binding ResetSmartRoutingCommand}" />
                </Grid>
                <Rectangle Style="{StaticResource Line}" />
                <Border Style="{StaticResource Row}">
                    <CheckBox Style="{StaticResource SwitchRow}" IsChecked="{Binding Smart.BypassRussianDomains}">
                        <StackPanel>
                            <TextBlock Text="Российские домены" Style="{StaticResource Row.Label}" />
                            <TextBlock Text=".ru  .рф  .su  и geosite:category-ru" Style="{StaticResource T.Caption}" />
                        </StackPanel>
                    </CheckBox>
                </Border>
                <Border Style="{StaticResource Row}">
                    <CheckBox Style="{StaticResource SwitchRow}" IsChecked="{Binding Smart.BypassRussianIps}">
                        <StackPanel>
                            <TextBlock Text="Российские IP-адреса" Style="{StaticResource Row.Label}" />
                            <TextBlock Text="Сайты на .com, которые хостятся в РФ" Style="{StaticResource T.Caption}" />
                        </StackPanel>
                    </CheckBox>
                </Border>
                <Border Style="{StaticResource Row}">
                    <CheckBox Style="{StaticResource SwitchRow}" IsChecked="{Binding Smart.BypassRussianBanking}">
                        <StackPanel>
                            <TextBlock Text="Банки, Госуслуги, маркетплейсы" Style="{StaticResource Row.Label}" />
                            <TextBlock Text="Они не пускают зарубежные IP" Style="{StaticResource T.Caption}" />
                        </StackPanel>
                    </CheckBox>
                </Border>
                <Border Style="{StaticResource Row}">
                    <CheckBox Style="{StaticResource SwitchRow}" IsChecked="{Binding Smart.BypassLan}">
                        <StackPanel>
                            <TextBlock Text="Локальная сеть" Style="{StaticResource Row.Label}" />
                            <TextBlock Text="Роутер, принтер, NAS" Style="{StaticResource T.Caption}" />
                        </StackPanel>
                    </CheckBox>
                </Border>
                <Border Style="{StaticResource Row}">
                    <CheckBox Style="{StaticResource SwitchRow}" IsChecked="{Binding Smart.DirectBittorrent}">
                        <StackPanel>
                            <TextBlock Text="Торренты" Style="{StaticResource Row.Label}" />
                            <TextBlock Text="Не тратят трафик подписки" Style="{StaticResource T.Caption}" />
                        </StackPanel>
                    </CheckBox>
                </Border>

                <!-- ================= proxy ================= -->
                <TextBlock Text="Через VPN" Style="{StaticResource T.Label}" Margin="0,36,0,6" />
                <Rectangle Style="{StaticResource Line}" />
                <Border Style="{StaticResource Row}">
                    <CheckBox Style="{StaticResource SwitchRow}" IsChecked="{Binding Smart.ProxyPopularServices}">
                        <StackPanel>
                            <TextBlock Text="Популярные сервисы" Style="{StaticResource Row.Label}" />
                            <TextBlock Text="YouTube, Discord, Instagram, X, Telegram, ChatGPT, Spotify…" Style="{StaticResource T.Caption}" />
                        </StackPanel>
                    </CheckBox>
                </Border>
                <Border Style="{StaticResource Row}">
                    <CheckBox Style="{StaticResource SwitchRow}" IsChecked="{Binding Smart.ProxyBlockedList}">
                        <StackPanel>
                            <TextBlock Text="Реестр блокировок" Style="{StaticResource Row.Label}" />
                            <TextBlock Text="geosite: refilter, ru-blocked" Style="{StaticResource T.Caption}" />
                        </StackPanel>
                    </CheckBox>
                </Border>
                <Border Style="{StaticResource Row}">
                    <CheckBox Style="{StaticResource SwitchRow}" IsChecked="{Binding Smart.ProxyDiscordVoice}">
                        <StackPanel>
                            <TextBlock Text="Голос Discord" Style="{StaticResource Row.Label}" />
                            <TextBlock Text="Работает в режиме TUN" Style="{StaticResource T.Caption}" />
                        </StackPanel>
                    </CheckBox>
                </Border>

                <!-- ================= block ================= -->
                <TextBlock Text="Блокировать" Style="{StaticResource T.Label}" Margin="0,36,0,6" />
                <Rectangle Style="{StaticResource Line}" />
                <Border Style="{StaticResource Row}">
                    <CheckBox Style="{StaticResource SwitchRow}" IsChecked="{Binding Smart.BlockQuic}">
                        <StackPanel>
                            <TextBlock Text="QUIC (UDP 443)" Style="{StaticResource Row.Label}" />
                            <TextBlock Text="Часто чинит YouTube через прокси" Style="{StaticResource T.Caption}" />
                        </StackPanel>
                    </CheckBox>
                </Border>
                <Border Style="{StaticResource Row}">
                    <CheckBox Style="{StaticResource SwitchRow}" IsChecked="{Binding Smart.BlockAds}">
                        <StackPanel>
                            <TextBlock Text="Реклама и трекеры" Style="{StaticResource Row.Label}" />
                            <TextBlock Text="geosite:category-ads-all" Style="{StaticResource T.Caption}" />
                        </StackPanel>
                    </CheckBox>
                </Border>
                <Border Style="{StaticResource Row}">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Всё остальное" Style="{StaticResource Row.Label}" />
                            <TextBlock Text="Что не попало ни в одно правило" Style="{StaticResource T.Caption}" />
                        </StackPanel>
                        <ComboBox Style="{StaticResource Combo}" HorizontalAlignment="Right" MinWidth="160"
                                  ItemsSource="{Binding RuleActions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Smart.DefaultAction}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Row}">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Стратегия доменов" Style="{StaticResource Row.Label}" />
                            <TextBlock Text="IPIfNonMatch нужен для «российских IP»" Style="{StaticResource T.Caption}" />
                        </StackPanel>
                        <ComboBox Style="{StaticResource Combo}" HorizontalAlignment="Right" MinWidth="260"
                                  ItemsSource="{Binding DomainStrategies}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Smart.DomainStrategy}" />
                    </Grid>
                </Border>

                <!-- ================= custom rules ================= -->
                <Grid Margin="0,44,0,6">
                    <TextBlock Text="Свои правила" Style="{StaticResource T.Label}" Margin="0" />
                    <Button Style="{StaticResource Btn.Link}" Content="+ Правило" HorizontalAlignment="Right" Command="{Binding AddRuleCommand}" />
                </Grid>
                <WrapPanel Margin="0,0,0,10">
                    <Button Style="{StaticResource Btn.Chip}" Content="Discord целиком" Margin="0,0,6,6" Command="{Binding AddRuleCommand}" CommandParameter="discord" />
                    <Button Style="{StaticResource Btn.Chip}" Content="Игры напрямую" Margin="0,0,6,6" Command="{Binding AddRuleCommand}" CommandParameter="games" />
                    <Button Style="{StaticResource Btn.Chip}" Content="Steam напрямую" Margin="0,0,6,6" Command="{Binding AddRuleCommand}" CommandParameter="steam" />
                    <Button Style="{StaticResource Btn.Chip}" Content="Торрент-клиенты напрямую" Margin="0,0,6,6" Command="{Binding AddRuleCommand}" CommandParameter="torrent" />
                </WrapPanel>
                <Rectangle Style="{StaticResource Line}" />

                <TextBlock Text="Правил нет. Правила «Процесс» работают только в TUN." Style="{StaticResource T.Caption}" Margin="0,14"
                           Visibility="{Binding Rules.Count, Converter={StaticResource BoolToVisInv}}" />

                <ItemsControl ItemsSource="{Binding Rules}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:RuleItemViewModel}">
                            <Border Style="{StaticResource Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <CheckBox Style="{StaticResource Toggle.Switch}" IsChecked="{Binding Enabled}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" Style="{StaticResource Combo}" MinWidth="0" Margin="-8,0,8,0"
                                              ItemsSource="{Binding DataContext.RuleKinds, ElementName=Self}"
                                              DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Kind}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Input.Mono}" Tag="{Binding Hint}"
                                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                    <ComboBox Grid.Column="3" Style="{StaticResource Combo}" MinWidth="0" Margin="8,0"
                                              ItemsSource="{Binding DataContext.RuleActions, ElementName=Self}"
                                              DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Action}" />
                                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                                        <Button Style="{StaticResource Btn.Icon}" ToolTip="Выше"
                                                Command="{Binding DataContext.MoveRuleUpCommand, ElementName=Self}" CommandParameter="{Binding}">
                                            <Path Style="{StaticResource Icon.Xs}" Data="{StaticResource I.ChevronUp}" />
                                        </Button>
                                        <Button Style="{StaticResource Btn.Icon}" ToolTip="Ниже"
                                                Command="{Binding DataContext.MoveRuleDownCommand, ElementName=Self}" CommandParameter="{Binding}">
                                            <Path Style="{StaticResource Icon.Xs}" Data="{StaticResource I.ChevronDown}" />
                                        </Button>
                                        <Button Style="{StaticResource Btn.Icon}" ToolTip="Удалить"
                                                Command="{Binding DataContext.RemoveRuleCommand, ElementName=Self}" CommandParameter="{Binding}">
                                            <Path Style="{StaticResource Icon.Xs}" Data="{StaticResource I.Close}" />
                                        </Button>
                                    </StackPanel>

                                    <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource Input.Inline}" FontSize="12.5"
                                             Foreground="{DynamicResource B.FgSecondary}" Margin="2,6,0,0" Tag="заметка"
                                             Text="{Binding Note}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ================= dns ================= -->
                <TextBlock Text="DNS" Style="{StaticResource T.Label}" Margin="0,44,0,6" />
                <Rectangle Style="{StaticResource Line}" />
                <Border Style="{StaticResource Row}">
                    <CheckBox Style="{StaticResource SwitchRow}" IsChecked="{Binding Settings.EnableDnsRouting}">
                        <StackPanel>
                            <TextBlock Text="Раздельный DNS" Style="{StaticResource Row.Label}" />
                            <TextBlock Text="Российские домены — через российский DNS, остальное — через DoH" Style="{StaticResource T.Caption}" />
                        </StackPanel>
                    </CheckBox>
                </Border>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Для VPN" Style="{StaticResource T.Caption}" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource Input.Mono}" Text="{Binding Settings.RemoteDns}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Для прямого" Style="{StaticResource T.Caption}" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource Input.Mono}" Text="{Binding Settings.DirectDns}" />
                    </StackPanel>
                </Grid>

                <!-- ================= check ================= -->
                <Grid Margin="0,44,0,6">
                    <TextBlock Text="Проверка" Style="{StaticResource T.Label}" Margin="0" />
                    <Button Style="{StaticResource Btn.Link}" Content="Проверить IP" HorizontalAlignment="Right"
                            Command="{Binding CheckIpCommand}" IsEnabled="{Binding IsCheckingIp, Converter={StaticResource InvBool}}" />
                </Grid>
                <Rectangle Style="{StaticResource Line}" />
                <UniformGrid Columns="2" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Напрямую" Style="{StaticResource T.Caption}" />
                        <TextBlock Text="{Binding DirectIp, TargetNullValue='—'}" FontFamily="{StaticResource F.Mono}" FontSize="16"
                                   Foreground="{DynamicResource B.Fg}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Через VPN" Style="{StaticResource T.Caption}" />
                        <TextBlock Text="{Binding ProxiedIp, TargetNullValue='—'}" FontFamily="{StaticResource F.Mono}" FontSize="16"
                                   Foreground="{DynamicResource B.Success}" Margin="0,4,0,0" />
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Style="{StaticResource ApplyBar}">
            <Grid>
                <TextBlock Style="{StaticResource T.Caption}" VerticalAlignment="Center"
                           Text="Вступит в силу после «Применить» — VPN переподключится" />
                <Button Style="{StaticResource Btn.Primary}" Content="Применить" HorizontalAlignment="Right" Command="{Binding ApplyCommand}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
