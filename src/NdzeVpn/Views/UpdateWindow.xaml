<Window x:Class="NdzeVpn.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Обновление — Ndze VPN" Icon="/Assets/app.ico"
        Width="520" SizeToContent="Height" MaxHeight="640"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="True"
        Background="{DynamicResource B.Window}" Foreground="{DynamicResource B.Fg}"
        FontFamily="{DynamicResource F.Main}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource B.Border}" BorderThickness="1">
        <Grid>
            <Button Style="{StaticResource Btn.CaptionClose}" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Click="Close_Click" IsEnabled="{Binding IsDownloadingUpdate, Converter={StaticResource InvBool}}">
                <Path Style="{StaticResource Icon.Caption}" Data="{StaticResource I.WinClose}" />
            </Button>

            <StackPanel Margin="32,36,32,28">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="/Assets/logo.png" Width="52" Height="52" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource T.H2}" FontSize="19">
                            <Run Text="Доступна версия" /> <Run Text="{Binding AvailableUpdate.Version, Mode=OneWay, StringFormat={}{0}}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource T.Caption}" Margin="0,3,0,0">
                            <Run Text="Сейчас установлена" /> <Run Text="{Binding AppVersion, Mode=OneWay}" />
                            <Run Text="  ·  " /><Run Text="{Binding AvailableUpdate.InstallerSize, Mode=OneWay, Converter={StaticResource Bytes}}" />
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- release notes straight from the GitHub release body -->
                <Border Margin="0,24,0,0" BorderBrush="{DynamicResource B.Border}" BorderThickness="1"
                        CornerRadius="{DynamicResource R.Card}" Background="{DynamicResource B.Panel}"
                        Visibility="{Binding AvailableUpdate.Notes, Converter={StaticResource NullToVis}}">
                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding AvailableUpdate.Notes}" TextWrapping="Wrap" Margin="16,14" LineHeight="20"
                                   FontSize="13" Foreground="{DynamicResource B.FgSecondary}" />
                    </ScrollViewer>
                </Border>

                <!-- progress -->
                <StackPanel Margin="0,20,0,0" Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVis}}">
                    <ProgressBar Style="{StaticResource Progress.Thin}" Height="3" Maximum="100" Value="{Binding UpdateProgress, Mode=OneWay}" />
                </StackPanel>
                <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource T.Caption}" Margin="0,10,0,0" TextWrapping="Wrap" TextTrimming="None" />

                <TextBlock Style="{StaticResource T.Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,0"
                           Text="VPN отключится на время установки, ключи и настройки сохранятся. Программа перезапустится сама." />

                <Grid Margin="0,24,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Btn.Link}" FontSize="12.5" Command="{Binding OpenReleasePageCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="На GitHub" />
                                <Path Style="{StaticResource Icon.Xs}" Data="{StaticResource I.External}" Margin="5,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Btn.Link}" FontSize="12.5" Content="Пропустить версию" Margin="18,0,0,0"
                                Click="Skip_Click" IsEnabled="{Binding IsDownloadingUpdate, Converter={StaticResource InvBool}}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Btn.Outline}" Content="Позже" Margin="0,0,10,0" Click="Close_Click"
                                Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVisInv}}" />
                        <Button Style="{StaticResource Btn.Outline}" Content="Отмена" Margin="0,0,10,0" Command="{Binding CancelUpdateCommand}"
                                Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVis}}" />
                        <Button Style="{StaticResource Btn.Primary}" Command="{Binding InstallUpdateCommand}"
                                IsEnabled="{Binding IsDownloadingUpdate, Converter={StaticResource InvBool}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon.Sm}" Data="{StaticResource I.Download}" Margin="0,0,8,0" />
                                <TextBlock Text="Обновить" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
